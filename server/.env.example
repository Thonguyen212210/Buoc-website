# ===== Cấu hình dự án Bước (sao chép file này thành .env rồi điền) =====

# Cổng chạy server (Nginx sẽ proxy về cổng này)
PORT=3000

# Mục tiêu gây quỹ (VND)
CAMPAIGN_GOAL=5000000

# Hạn chót chiến dịch (tùy chọn, định dạng YYYY-MM-DD) để hiển thị "còn N ngày"
CAMPAIGN_DEADLINE=2026-07-15

# --- Thông tin nhận tiền (dùng để sinh mã VietQR của SePay) ---
BANK_ACCOUNT=0000000000
# Nhận theo code/bin/short_name/alias, xem https://qr.sepay.vn/banks.json (vd: VCB, Vietcombank, 970436)
BANK_NAME=Vietcombank
ACCOUNT_HOLDER=DU AN BUOC
# Tiền tố nội dung chuyển khoản — nên trùng bộ lọc webhook trên SePay
TRANSFER_PREFIX=BUOC

# --- Bảo mật webhook ---
# Đặt cùng giá trị này ở mục Bảo mật (API Key) khi tạo webhook trên my.sepay.vn
# SePay sẽ gửi header: Authorization: Apikey <SEPAY_WEBHOOK_APIKEY>
SEPAY_WEBHOOK_APIKEY=doi-thanh-chuoi-bi-mat-ngau-nhien

# Token quản trị cho /api/simulate và /api/admin/donations
ADMIN_TOKEN=doi-thanh-token-quan-tri

# Cho phép endpoint giả lập /api/simulate (đặt false khi chạy thật)
ALLOW_SIMULATE=true

# (Tùy chọn) ghi đè đường dẫn thư mục web tĩnh và thư mục dữ liệu
# STATIC_DIR=/var/www/buoc/website
# DATA_DIR=/var/www/buoc/server/data
